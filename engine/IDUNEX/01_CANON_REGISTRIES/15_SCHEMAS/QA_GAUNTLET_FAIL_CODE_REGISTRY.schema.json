{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "IDUNEX/15_SCHEMAS/QA_GAUNTLET_FAIL_CODE_REGISTRY.schema.json",
  "title": "QA_GAUNTLET_FAIL_CODE_REGISTRY object schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "scene_environment_spatial_physics",
    "profile360_fail_codes",
    "status"
  ],
  "properties": {
    "scene_environment_spatial_physics": {
      "type": "array",
      "minItems": 13,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "fail_code",
          "definition",
          "trigger",
          "affected_fields",
          "prompt_fix",
          "negative_prompt_fix",
          "qa_fix",
          "manual_fallback",
          "sidecar_evidence_field",
          "severity",
          "retest_rule"
        ],
        "properties": {
          "fail_code": {
            "type": "string",
            "pattern": "^ENV-[A-Z]+$"
          },
          "definition": {
            "type": "string",
            "minLength": 20
          },
          "trigger": {
            "type": "string",
            "minLength": 20
          },
          "affected_fields": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "prompt_fix": {
            "type": "string",
            "minLength": 20
          },
          "negative_prompt_fix": {
            "type": "string",
            "minLength": 20
          },
          "qa_fix": {
            "type": "string",
            "minLength": 20
          },
          "manual_fallback": {
            "type": "string",
            "minLength": 20
          },
          "sidecar_evidence_field": {
            "type": "string",
            "minLength": 3
          },
          "severity": {
            "type": "string",
            "minLength": 1
          },
          "retest_rule": {
            "type": "string",
            "minLength": 5
          }
        }
      }
    },
    "profile360_fail_codes": {
      "type": "string",
      "pattern": "^see 04_PROFILE360_SYSTEM/05_QA_FAILCODES/PROFILE360_FAILCODES\\.json$"
    },
    "status": {
      "type": "string",
      "const": "PRODUCTIVE_BASE_ENGINE_VALIDATED"
    }
  },
  "x-historical-ca146-surgical-fix-note": "P0-04 validates current object-form 13_QA_GAUNTLET/FAIL_CODE_REGISTRY.json without destructive conversion.",
  "x-historical-ca146-surgical-fix-policy": "HISTORICAL_ONLY_NOT_ACTIVE_ENGINE_POLICY",
  "x-historical-ca146-surgical-fix-do-not-use-as-base": "DO_NOT_USE_AS_BASE",
  "x-updated_at": "NEUTRALIZED_ACTIVE_SCOPE"
}
