    "watermark_required": {
      "type": "boolean"
    },
    "watermark_method": {
      "type": "string"
    },
    "watermark_text": {
      "type": "string"
    },
    "watermark_position": {
      "type": "string"
    },
    "watermark_optout_state": {
      "type": "string"
    }
